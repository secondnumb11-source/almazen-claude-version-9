# ===============================================
#  قالب متغيرات البيئة (Environment Variables)
#  انسخ هذا الملف إلى .env محليًا
#  وأضف نفس القيم في Vercel:
#  Project → Settings → Environment Variables
#  (اختر Production + Preview + Development)
# ===============================================

# --- مطلوب: اتصال قاعدة البيانات (Lovable Cloud / Supabase) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-ref

# --- مطلوب أثناء البناء على Vercel فقط (مضبوط مسبقًا في vercel.json) ---
# NITRO_PRESET=vercel

# --- اختياري: مفاتيح الخادم (لا تبدأ بـ VITE_ حتى لا تُكشف للمتصفح) ---
# SUPABASE_SERVICE_ROLE_KEY=
# LOVABLE_API_KEY=
